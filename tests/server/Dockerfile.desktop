FROM alpine:3.20
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN apk add --no-cache \
    openssh-server openssh-sftp-server x11vnc xvfb \
    xfce4 xfce4-terminal thunar mousepad firefox \
    xfce4-clipman-plugin xclip \
    adwaita-icon-theme dbus font-noto font-noto-emoji && \
    ssh-keygen -A && \
    adduser -D -s /bin/sh lucarna && sed -i 's/^lucarna:!/lucarna:*/' /etc/shadow && \
    mkdir -p /home/lucarna/.ssh /home/lucarna/ft /run/dbus && \
    printf 'lucarna sftp test\n' > /home/lucarna/ft/hello.txt && \
    chown -R lucarna:lucarna /home/lucarna && chmod 700 /home/lucarna/.ssh && \
    printf 'PasswordAuthentication no\nPermitRootLogin no\nAllowTcpForwarding local\nGatewayPorts no\nSubsystem sftp internal-sftp\n' \
        > /etc/ssh/sshd_config.d/lucarna.conf && \
    dbus-uuidgen > /var/lib/dbus/machine-id

EXPOSE 22
CMD set -e; \
    [ -n "$AUTHORIZED_KEY" ] || { echo "set AUTHORIZED_KEY" >&2; exit 1; }; \
    echo "$AUTHORIZED_KEY" > /home/lucarna/.ssh/authorized_keys; \
    chown lucarna:lucarna /home/lucarna/.ssh/authorized_keys; chmod 600 /home/lucarna/.ssh/authorized_keys; \
    Xvfb :0 -screen 0 1280x800x24 & sleep 1; \
    DISPLAY=:0 dbus-launch --exit-with-session startxfce4 & \
    sleep 2; DISPLAY=:0 xfce4-clipman & \
    x11vnc -display :0 -localhost -passwd "${VNC_PASSWORD:-secret}" -forever -shared -quiet & \
    exec /usr/sbin/sshd -D -e
